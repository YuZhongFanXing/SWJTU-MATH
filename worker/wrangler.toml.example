name = "swjtu-math-api"
main = "src/index.js"
compatibility_date = "2026-01-01"

[vars]
FRONTEND_ORIGIN = "https://your-site.example.com"
GITHUB_REPOSITORY = "YuZhongFanXing/SWJTU-MATH"
GITHUB_APP_ID = "replace-me"
GITHUB_INSTALLATION_ID = "replace-me"

[[kv_namespaces]]
binding = "SESSIONS"
id = "replace-with-kv-id"

# 使用 wrangler secret put 设置，禁止提交到仓库：
# GITHUB_OAUTH_CLIENT_ID
# GITHUB_OAUTH_CLIENT_SECRET
# GITHUB_APP_PRIVATE_KEY
